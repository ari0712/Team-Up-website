# Copy to `.env` and fill in. `.env` is git-ignored — never commit real credentials.
# Anything already set in your real environment wins over this file.

# ── Which transport sends notification email ────────────────────────────────
#   console   records to the outbox and the log, sends nothing   (default)
#   ethereal  real SMTP to a disposable test inbox, no credentials needed;
#             each message gets a preview URL you can open in a browser
#   smtp      real delivery using the SMTP_* settings below
MAIL_TRANSPORT=console

# ── SAFETY ──────────────────────────────────────────────────────────────────
# With MAIL_REDIRECT_TO set, EVERY message goes to this one address no matter
# who the notification was for. The intended recipient is preserved in the
# outbox and named in the message body.
#
# The database contains third-party addresses. Running MAIL_TRANSPORT=smtp
# WITHOUT this set will send real mail to every one of them.
MAIL_REDIRECT_TO=

# Optional. Comma-separated addresses, or "@domain" to match a whole domain.
# Anything not matching is recorded as skipped instead of being sent.
# Ignored when MAIL_REDIRECT_TO is set.
MAIL_ALLOWLIST=

# ── SMTP settings (only used when MAIL_TRANSPORT=smtp) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TeamUp <no-reply@example.com>

# Gmail: enable 2-Step Verification, then create a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords). A normal
# account password will be rejected.
#   MAIL_TRANSPORT=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password
